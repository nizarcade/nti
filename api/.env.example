# Server
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8090
ALLOWED_ORIGINS=http://localhost:3030,http://127.0.0.1:3030

# Database
# Put the real production DATABASE_URL in your hosting provider's environment
# variables. Do not commit database credentials to GitHub.
DATABASE_URL=sqlite:///./nti.db

# Stripe
# Put real Stripe keys in environment variables. Never commit them.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_MAP={}

# Donation receipts / organization
RECEIPT_FROM_EMAIL=info@northerntransformationinitiative.org
ORG_LEGAL_NAME=Northern Transformation Initiative
ORG_ADDRESS=P.O. Box 14271-00100, Nairobi, Kenya

# Frontend public URL
PUBLIC_WEB_URL=http://localhost:3030

# Contact form destination
CONTACT_TO_EMAIL=info@northerntransformationinitiative.org

# SMTP
# Configure real SMTP credentials privately in the deployment environment.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=info@northerntransformationinitiative.org

# Admin
ADMIN_USERNAME=
ADMIN_PASSWORD=

# JWT
# Set a strong secret privately in production.
JWT_SECRET=
JWT_ALG=HS256
JWT_EXPIRES_MIN=480
JWT_EXPIRES_MIN=480
