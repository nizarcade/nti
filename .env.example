# Development env (used by `npm run dev` on host).
# In production the SPA is served by nginx which proxies /api → api:8090,
# so VITE_API_BASE_URL should be left empty for the prod build (see
# .env.production.example and docker-compose.yml).
VITE_API_BASE_URL=http://localhost:8090
VITE_PAYPAL_CLIENT_ID=
